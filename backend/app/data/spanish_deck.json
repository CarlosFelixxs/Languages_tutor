      "example_target": "Voy al mercado.",
      "tags": ["verb", "irregular"]
    },
    {
      "front": "ter (possuir)",
      "back": "tener",
      "pronunciation": "te-NER",
      "grammar_note": "Conjugação: tengo, tienes, tiene, tenemos, tenéis, tienen.",
