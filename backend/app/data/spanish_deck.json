      "example_target": "Quiero beber agua.",
      "tags": ["verb", "cognate"]
    },
    {
      "front": "poder (ser capaz de)",
      "back": "poder",
      "grammar_note": "Puedo, puedes, puede, podemos, podéis, pueden (diptongo o→ue).",
