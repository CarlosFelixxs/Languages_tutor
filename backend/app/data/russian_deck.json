    },
    {
      "front": "Meu nome é...",
      "back": "Меня зовут... [menya zovut]",
      "pronunciation": "mye-NYA za-VOOT",
      "grammar_note": "Literal: 'Me chamam de...' — russo NÃO usa verbo 'ser' no presente!",
      "example_target": "Меня зовут Карлос. (Meu nome é Carlos.)",
      "tags": ["introductions", "grammar"]
    },
    {
      "front": "Como vai? (informal)",
      "back": "Как дела? [kak dela]",
      "pronunciation": "kak dye-LA",
      "grammar_note": "Literal: 'Como estão os assuntos?'. Resposta: 'Хорошо' (bem) ou 'Нормально' (normal/ok).",
