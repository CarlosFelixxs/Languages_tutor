{
  "deck": {
    "name": "Russo do Zero",
    "language": "russian",
    "description": "Do zero: alfabeto cirílico, fonética e vocabulário básico para falantes de português brasileiro.",
    "is_builtin": 1
  },
  "cards": [
    {
      "front": "А а",
      "back": "A — como em 'casa'",
      "pronunciation": "a",
      "grammar_note": "Idêntico ao A do português!",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "О о",
      "back": "O — como em 'bola' (tônico) ou 'a' (átono)",
      "pronunciation": "o / a",
      "grammar_note": "Quando tônico: O. Quando átono: soa 'a'. 'Молоко' [malakO] = leite.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "М м",
      "back": "M — como em 'mãe'",
      "pronunciation": "m",
      "grammar_note": "Idêntico ao M do português.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Т т",
      "back": "T — como em 'tudo' (nunca 'tchi')",
      "pronunciation": "t",
      "grammar_note": "O T russo nunca palataliza como o T carioca. Sempre 't' limpo.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "К к",
      "back": "K — como em 'casa'",
      "pronunciation": "k",
      "grammar_note": "Idêntico!",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "В в",
      "back": "V — como em 'você' ⚠️ Parece B!",
      "pronunciation": "v",
      "grammar_note": "ARMADILHA: parece um B, mas é V! В = V do português.",
      "tags": ["alphabet", "tricky"]
    },
    {
      "front": "Н н",
      "back": "N — como em 'nada' ⚠️ Parece H!",
      "pronunciation": "n",
      "grammar_note": "ARMADILHA: parece H, mas é N! Н = N do português.",
      "tags": ["alphabet", "tricky"]
    },
    {
      "front": "С с",
      "back": "S — como em 'sol' ⚠️ Parece C!",
      "pronunciation": "s",
      "grammar_note": "ARMADILHA: parece C, mas é S! С = S do português.",
      "tags": ["alphabet", "tricky"]
    },
    {
      "front": "Р р",
      "back": "R vibrante — ⚠️ Parece P!",
      "pronunciation": "r",
      "grammar_note": "ARMADILHA: parece P, mas é R! Р = R vibrante (como no espanhol 'perro').",
      "tags": ["alphabet", "tricky"]
    },
    {
      "front": "У у",
      "back": "U — como em 'uva' ⚠️ Parece Y!",
      "pronunciation": "u",
      "grammar_note": "ARMADILHA: parece Y de lado, mas é U!",
      "tags": ["alphabet", "tricky"]
    },
    {
      "front": "Е е",
      "back": "YE — como em 'yeah'",
      "pronunciation": "ye",
      "grammar_note": "Soa 'ye' no início de sílaba. 'нет' [nyet] = não.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "И и",
      "back": "I — como em 'sim'",
      "pronunciation": "i",
      "grammar_note": "Como o I do português.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Л л",
      "back": "L — como em 'lua'",
      "pronunciation": "l",
      "grammar_note": "Idêntico!",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Б б",
      "back": "B — como em 'bola'",
      "pronunciation": "b",
      "grammar_note": "Idêntico ao B do português.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Д д",
      "back": "D — como em 'dado'",
      "pronunciation": "d",
      "grammar_note": "Idêntico!",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Г г",
      "back": "G — como em 'gato'",
      "pronunciation": "g",
      "grammar_note": "Sempre G duro, nunca J como em português.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "П п",
      "back": "P — como em 'pai' ⚠️ Parece ∏!",
      "pronunciation": "p",
      "grammar_note": "Como o P do português.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "З з",
      "back": "Z — como em 'zero'",
      "pronunciation": "z",
      "grammar_note": "Como o Z do português.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Ф ф",
      "back": "F — como em 'faca'",
      "pronunciation": "f",
      "grammar_note": "Idêntico!",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Ш ш",
      "back": "SH — como em 'chuva' (português de SP)",
      "pronunciation": "sh",
      "grammar_note": "Som 'ch' do carioca ou 'sh' do inglês. 'Хорошо' [khorosho] = bem/bom.",
      "tags": ["alphabet", "new_sound"]
    },
    {
      "front": "Ж ж",
      "back": "ZH — como o 'j' em 'journal' (francês)",
      "pronunciation": "zh",
      "grammar_note": "Como o 'j' francês ou o 'j' de 'jeans'. Ex: 'Москва' não tem, mas 'жена' [zhena] = esposa.",
      "tags": ["alphabet", "new_sound"]
    },
    {
      "front": "Х х",
      "back": "KH — como o 'ch' alemão ou R carioca",
      "pronunciation": "kh",
      "grammar_note": "Fricativo velar — parecido com o R carioca! 'хорошо' [khorosho] = bem.",
      "tags": ["alphabet", "new_sound"]
    },
    {
      "front": "Ц ц",
      "back": "TS — como em 'tsé-tsé'",
      "pronunciation": "ts",
      "grammar_note": "Combinação TS em uma letra. 'Отец' [atets] = pai.",
      "tags": ["alphabet", "new_sound"]
    },
    {
      "front": "Ч ч",
      "back": "TCH — como em 'tchau'",
      "pronunciation": "tch",
      "grammar_note": "Idêntico ao 'tch' do português! 'Чай' [tchai] = chá.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Я я",
      "back": "YA — como em 'iá-iá'",
      "pronunciation": "ya",
      "grammar_note": "Também significa 'EU' em russo! Я = eu.",
      "tags": ["alphabet", "new_sound"]
    },
    {
      "front": "Ю ю",
      "back": "YU — como em 'você'",
      "pronunciation": "yu",
      "grammar_note": "Som 'yu'. 'Юг' [yug] = sul.",
      "tags": ["alphabet", "familiar"]
    },
    {
      "front": "Э э",
      "back": "E — como em 'mel' (aberto)",
      "pronunciation": "e",
      "grammar_note": "E aberto, sem o Y inicial do Е.",
      "tags": ["alphabet", "new_sound"]
    },
    {
      "front": "Ы ы",
      "back": "I gutural — não existe em português",
      "pronunciation": "y (gutural)",
      "grammar_note": "Som entre 'i' e 'u', pronunciado com a língua recuada. Pratique: diga 'i' mas puxe a língua para trás.",
      "tags": ["alphabet", "new_sound"]
    },
    {
      "front": "Ъ ъ (sinal duro)",
      "back": "Pausa — separa sílabas",
      "pronunciation": "— (separador)",
      "grammar_note": "Não tem som próprio. Indica que a consoante anterior é 'dura' (não palatalizada).",
      "tags": ["alphabet", "special"]
    },
    {
      "front": "Ь ь (sinal mole)",
      "back": "Palatalização — suaviza a consoante anterior",
      "pronunciation": "' (palatal)",
      "grammar_note": "Suaviza a consoante: 'ть' = t' (mais suave). 'Мать' [mat'] = mãe.",
      "tags": ["alphabet", "special"]
    },
    {
      "front": "Oi! (informal)",
      "back": "Привет! [privet]",
      "pronunciation": "pri-VYET",
      "grammar_note": "Informal — use com amigos. O formal é 'Здравствуйте' [zdrastvuyte].",
      "example_target": "Привет! Как дела? (Oi! Como vai?)",
      "tags": ["greeting", "basic"]
    },
    {
      "front": "Olá! (formal)",
      "back": "Здравствуйте! [zdravstvuyte]",
      "pronunciation": "ZDRAS-tvuy-tye",
      "grammar_note": "Formal/plural. Para uma pessoa (informal): 'Здравствуй' [zdravstvuy].",
      "tags": ["greeting", "formal"]
    },
    {
      "front": "Tchau! / Até logo!",
      "back": "Пока! [poka]",
      "pronunciation": "pa-KA",
      "grammar_note": "Informal. Mais formal: 'До свидания' [da svidaniya].",
      "tags": ["greeting", "basic"]
    },
    {
      "front": "Obrigado/a",
      "back": "Спасибо [spasibo]",
      "pronunciation": "spa-SI-ba",
      "grammar_note": "Não muda para masculino/feminino! Uma forma só.",
      "example_target": "Большое спасибо! (Muito obrigado!)",
      "tags": ["greeting", "basic"]
    },
    {
      "front": "Por favor",
      "back": "Пожалуйста [pozhaluysta]",
      "pronunciation": "pa-ZHA-lus-ta",
      "grammar_note": "Também significa 'De nada' como resposta a obrigado!",
      "tags": ["greeting", "basic"]
    },
    {
      "front": "Sim",
      "back": "Да [da]",
      "pronunciation": "da",
      "grammar_note": "Simples! Да = da.",
      "tags": ["basic"]
    },
    {
      "front": "Não",
      "back": "Нет [nyet]",
      "pronunciation": "nyet",
      "grammar_note": "Нет = não. Com Н (N, não H) e Е (ye).",
