    },
    {
      "front": "Eu (pronome)",
      "back": "Я [ya]",
      "pronunciation": "ya",
      "grammar_note": "Я = eu. Atenção: em russo, 'Я' pode ser omitido quando o contexto é claro.",
      "tags": ["pronoun", "basic"]
    },
    {
      "front": "você (singular informal)",
      "back": "ты [ty]",
      "pronunciation": "ty",
      "grammar_note": "Informal. O formal (você de respeito) é 'вы' [vy].",
      "tags": ["pronoun", "basic"]
    },
    {
      "front": "ele / ela",
      "back": "он [on] / она [ana]",
      "pronunciation": "on / a-NA",
      "grammar_note": "Gênero gramatical: 'он' para masculino, 'она' para feminino.",
      "tags": ["pronoun", "basic"]
    },
    {
      "front": "nós",
      "back": "мы [my]",
      "pronunciation": "my",
      "grammar_note": "Мы = nós.",
      "tags": ["pronoun", "basic"]
    },
    {
      "front": "Onde fica...?",
